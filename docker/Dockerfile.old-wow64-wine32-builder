ARG base_image=ubuntu:26.04
ARG make_max_jobs=2
ARG prefix

FROM $base_image AS source
SHELL ["/bin/bash", "-c"]
WORKDIR /build-wine

RUN --mount=type=bind,from=workdir,src=wine.src,dst=/wine.src \
    cp -r /wine.src /build-wine/wine.src

FROM source AS base
WORKDIR /build-wine

RUN apt update && apt upgrade -y

COPY scripts/install-deps.bash .
COPY deps/ ./
RUN ./install-deps.bash ./deps-tools.list
RUN ./install-deps.bash ./deps-libs.list
RUN ./install-deps.bash ./deps-libs_i386.list

FROM base AS tools

WORKDIR /build-wine/wine32-tools
RUN /build-wine/wine.src/configure \
    CFLAGS=-std=gnu11 \
    --disable-tests

ARG make_max_jobs
RUN make -j ${make_max_jobs}

FROM tools AS builder

RUN --mount=type=bind,from=workdir,src=wine64,dst=/wine64 \
    cp -r /wine64 /build-wine/wine64

WORKDIR /build-wine/wine32
ARG prefix
RUN /build-wine/wine.src/configure \
    CFLAGS=-std=gnu11 \
    --disable-tests \
    --with-wine64=/build-wine/wine64 \
    --with-wine-tools=/build-wine/wine32-tools \
    --prefix=${prefix}

ARG make_max_jobs
RUN make -j ${make_max_jobs}
RUN make install
