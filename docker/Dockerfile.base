# args:
#   BASE_IMAGE = base image name to run build
#   WINE_REPO     = wine source repositry url
#   WINE_BRANCH   = branch name to be built

ARG BASE_IMAGE=ubuntu:24.04

FROM $BASE_IMAGE
SHELL ["/bin/bash", "-c"]
WORKDIR /build_wine

ARG BASE_IMAGE
ENV BASE_IMAGE=$BASE_IMAGE
ARG WINE_REPO
ARG WINE_BRANCH

COPY install-tools install-devfiles .
RUN apt update && apt upgrade -y
RUN ./install-tools
RUN ./install-devfiles

RUN git clone --no-tags --depth 1 --branch "$WINE_BRANCH" "$WINE_REPO" wine.src
