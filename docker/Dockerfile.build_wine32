ARG BASE_IMAGE=ubuntu:24.04
ARG MAKE_MAX_JOBS=4

FROM $BASE_IMAGE
SHELL ["/bin/bash", "-c"]
WORKDIR /build_wine

ARG WINE64_PATH
COPY $WINE64_PATH /build_wine/wine64

RUN test -d /build_wine/wine64 && test -d /build_wine/wine32-tools

WORKDIR /build_wine/wine32

ARG PREFIX
RUN /build_wine/wine.src/configure \
    --with-wine64=../wine64 \
    --with-wine-tools=../wine32-tools \
    --prefix=${PREFIX}

ARG MAKE_MAX_JOBS
RUN make -j ${MAKE_MAX_JOBS}
RUN make install
