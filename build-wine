
#!/usr/bin/env bash
# a wine builder script.
# this script builts specific version of wine in a docker container.
# this script needs these commands: docker, git and jq
#
# refs:
# - https://gitlab.winehq.org/wine/wine/-/wikis/Building-Wine#shared-wow64
# - https://gitlab.winehq.org/wine/wine/-/wikis/Building-Biarch-Wine-On-Ubuntu
#set -eu -o pipefail

export WINE_REPO_BASE_URL=https://gitlab.winehq.org/wine
export WINE_REPO_NAME=wine
export WINE_STAGING_REPO_NAME=wine-staging

export DOCKER_PLATFORM_WINE32=linux/i386
export DOCKER_PLATFORM_WINE64=linux/amd64
export DOCKER_BASE_IMAGE32=i386/ubuntu:latest
export DOCKER_BASE_IMAGE64=ubuntu:26.04

export MAKE_MAX_JOBS=8

here=$(dirname $(readlink -f "$0"))

show_usage() {
  echo 'Usage: build-wine [OPTION] TARGET_OPTION PREFIX'
  echo
  echo 'Build a wine specified TARGET_OPTION and install it.'
  echo
  echo 'PREFIX is a directory to installed all of build results. If you run this script'
  echo 'like `build-wine 10.0 /path/to/mywine`, a binary `wine` is placed at'
  echo '`/path/to/mywine/bin/wine`.'
  echo 'So the WINELOADER for this should be set like `PREFIX/bin/wine`.'
  echo
  echo 'TARGET_OPTION determines the target to build. TARGET OPTIONS are mutually'
  echo 'exclusive so there is neccesary to choose one.'
  echo
  echo 'To build a specific version, choose `-v VERSION` target option. This will be a'
  echo 'tag in official git repository. Tags are tyipically named like `wine-<version>`.'
  echo 'The source will be cloned from official git repository.'
  echo
  echo 'To build with existed source, choose this `-d SRCDIR` option.'
  echo
  echo 'TARGET OPTIONS                  These options are mutually exclusive.'
  echo '   -v, --version=VERSION    ... Build wine with specified version.'
  echo '   -d, --source=SRCDIR      ... Build wine with sources placed on SRCDIR.'
  echo
  echo 'OTHER OPTION'
  echo '   -s, --staging            ... Build a staging version instead of winehq/wine'
  echo '                                repository. This option affects only builds'
  echo '                                git-cloned source, like -v option.'
  echo '   -h, --help               ... Show this message.'
  echo
}

show_error() {
  echo "error: ${1-}"
  echo  
  show_usage
  exit 1;
}

wine_version=
source_dir=
build_staging=no
old_wow64_build=no

opts=$(
  getopt -o v:d:soh \
    -l version: -l source: -l staging -l old-wow64 -l help \
    -n build-wine \
    -- "$@"
)
#echo opts = "$opts"
eval set -- "$opts"

while [ $# -gt 0 ]; do
  case "$1" in
    -v|--version)
      shift;
      wine_version=$1
      shift;
      ;;
    -d|--source)
      shift;
      source_dir=$1
      shift;
      ;;
    -s|--staging)
      build_staging=yes
      shift
      ;;
    -h|--help)
      show_usage; exit 1;
      shift
      ;;
    --)
      shift
      break
      ;;
    *)
      show_error "error: broken argv...?\n  opts = $opts\n  argv = $@"
  esac
done

prefix=$(realpath "${1:-}")

tmpdir=

wine_readme_grep_pat='Wine is a program which allows running Microsoft Windows programs'
source_dir_has_wine_readme() {
  local readme=

  if [ -r "${source_dir}/README" ]; then
    readme="${source_dir}/README";
  fi
  if [ -r "${source_dir}/README.md" ]; then
    readme="${source_dir}/README.md";
  fi

  fgrep -o "$wine_readme_grep_pat" "${readme}" >/dev/null 2>&1
  local ret=$?

  if [ $ret -ne 0 ]; then
    echo "readme = $readme"
  fi
  return $ret
}


wine_version_pat='[0-9]*\.[0-9]*(\.[0-9]*)?'
wine_version_pat_exact="^${wine_version_pat}\$"

prerequisties() {
  if [ -n "$source_dir" -a -n "$wine_version" ] || [ -z "${source_dir}${wine_version}" ]; then
    show_error 'Specify build target one of -v (--version) or -d (--source)'
  fi

  if [ -n "${wine_version}" ]; then
    if [[ ! "$wine_version" =~ $wine_version_pat_exact ]]; then
      show_error 'WINE_VERSION must be formatted as "xx.yy[.zz]".'
    fi
  fi

  if [ -n "$source_dir" ]; then
    if [ ! -d "$source_dir" ]; then
      show_error "source dir is not a directory: $source_dir"
    fi

    if ! source_dir_has_wine_readme; then
      echo 'error: source dir is not a wine source, maybe...?'
      echo "    source_dir = $source_dir"
      echo "This script checks the README's first line; checks it the line is:"
      echo "    $wine_readme_grep_pat"
      echo
      exit 1
    fi
  fi

  if [ -z "${prefix}" ]; then
    show_error 'PREFIX cannot be empty.'
  fi
  if [ -e "${prefix}" ]; then
    show_error "wine_${wine_version} is already installed at: ${prefix}"
  fi
}

setup() {
  tmpdir=$(mktemp -t --directory --tmpdir=/tmp "wine-builder_${wine_version}_XXXXX")
}

cleanup() {
  echo "deleting ${tmpdir}..."
  rm -rf "${tmpdir}"
}
#trap cleanup SIGINT

print_params() {
  echo 'build parameters:'
  echo "      wine_version = $wine_version"
  echo "     build_staging = $build_staging"
  echo "   old_wow64_build = $old_wow64_build"
  echo
  echo "    install prefix = $prefix"
  echo "    work directory = $tmpdir"
  echo "  source directory = $source_dir"
  echo
  echo "  used image (x86) = $DOCKER_BASE_IMAGE32"
  echo "  used image (x64) = $DOCKER_BASE_IMAGE64"
  echo
}

run_command() {
  "$@" | tee "${tmpdir}/build.log"
  if [ ${PIPESTATUS[0]} -ne 0 ]; then
    echo
    echo "command faild: $@"
    echo
    echo "failed to build wine ${wine_version}."
    echo "check the temp directory to see details."
    echo
    print_params
    exit 1
  fi
}

main() {
  # auto detection wine version for source specified builds
  if [ -n "$source_dir" ] && [ -r "${source_dir}/VERSION" ]; then
    wine_version=$(cat "${source_dir}/VERSION" | egrep -o "$wine_version_pat")
  fi
  # auto detectiton old or new wow64 build, when wine versoin specified.
  if [ -n "$wine_version" ] && [ "$(echo ""$wine_version"" | cut -d'.' -f1)" -lt 11 ]; then
    old_wow64_build=yes
  fi

  echo 'building wine...'
  run_command print_params

  echo 'preparing source...'
  if [ -n "$source_dir" ]; then
    run_command echo "copying existing source in ${source_dir}..."
    cp -r "${source_dir}/" "$tmpdir/wine.src"
  else
    if [ "$build_staging" = yes ]; then
      run_command "${here}/scripts/setup-wine-staging-source.bash"  "$tmpdir" "$wine_version"
    else
      run_command "${here}/scripts/setup-wine-source.bash"          "$tmpdir" "$wine_version"
    fi
  fi

  echo 'start building...'
  if [ "$old_wow64_build" = yes ]; then
    run_command "${here}/scripts/build-wine_old-wow64-build.bash" "$tmpdir" "$wine_version" "$prefix"
  else
    run_command "${here}/scripts/build-wine_new-wow64-build.bash" "$tmpdir" "$wine_version" "$prefix"
  fi
}

prerequisties
setup
main
cleanup
