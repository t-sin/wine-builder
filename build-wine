#!/usr/bin/env bash
# a wine builder script.
# this script builts specific version of wine in a docker container.
# this script needs these commands: docker, git and jq
#
# refs:
# - https://gitlab.winehq.org/wine/wine/-/wikis/Building-Wine#shared-wow64
# - https://gitlab.winehq.org/wine/wine/-/wikis/Building-Biarch-Wine-On-Ubuntu
set -eu -o pipefail

export WINE_REPO_BASE_URL=https://gitlab.winehq.org/wine
export WINE_REPO_NAME=wine
export WINE_STAGING_REPO_NAME=wine-staging

here=$(dirname $(readlink -f "$0"))

usage() {

  echo 'Usage: build-wine VERSION PREFIX'
  echo
  echo 'Build a specific version of wine and install it'
  echo
  echo 'The VERSION will be used to determine a tag to clone git repository. Tags are'
  echo 'tyipically named like `wine-<version>`'
  echo
  echo 'PREFIX is a directory to installed all of build results.'
  echo 'If you run this script like `build-wine 10.0 /path/to/mywine`, a binary `wine` is'
  echo 'placed at `/path/to/mywine/bin/wine`.'
  echo 'So the WINELOADER for this should be set like `PREFIX/bin/wine`'
  echo
  echo 'OPTIONS'
  echo '   -s, --staging          Build a staging version instead of normal wine source tree.'
  echo
  exit 1
}

build_staging=no
new_wow64_build=no

opts=$(getopt -o s -l staging -n build-wine -- "$@")
eval set -- "$opts"

while [ $# -gt 0 ]; do
  case "$1" in
    -s|--staging)
      build_staging=yes
      shift
      ;;
    --)
      shift
      break
      ;;
    *)
      echo 'broken argv...?'
      echo "argv = $@"
      usage
  esac
done

wine_version=${1:-}
prefix=$(realpath "${2:-}")
install_path="${prefix}/wine_${wine_version}"

tmpdir=

prerequisties() {
  if [ -z "${wine_version}" ]; then
    echo 'ERROR: WINE_VERSION cannot be empty.'
    echo
    usage
  fi

  if [ -z "${prefix}" ]; then
    echo 'ERROR: PREFIX cannot be empty.'
    echo
    usage
  fi

  if [ -e "${install_path}" ]; then
    echo "ERROR: wine ${wine_version} is already installed at:"
    echo "   ${install_path}"
    echo
    usage
  fi
}

setup() {
  tmpdir=$(mktemp -t --directory --tmpdir=/tmp "wine-builder_${wine_version}_XXXXX")
}

cleanup() {
  echo "deleting ${tmpdir}..."
  rm -rf "${tmpdir}"
}
#trap cleanup SIGINT

main() {
  if [ "$(echo ""$wine_version"" | cut -d'.' -f1)" -ge 11 ]; then
    new_wow64_build=yes
  fi

  echo
  echo 'building wine with those parameters:'
  echo "   wine_version    = $wine_version"
  echo "   build_staging   = $build_staging"
  echo "   new_wow64_build = $new_wow64_build"
  echo
  echo "   prefix          = $prefix"
  echo "   install_path    = $install_path"
  echo
  echo "   tmpdir          = $tmpdir"
  echo

  if [ "$build_staging" = yes ]; then
    "${here}/scripts/setup-wine-staging-source.bash"  "$tmpdir" "$wine_version"
  else
    "${here}/scripts/setup-wine-source.bash"          "$tmpdir" "$wine_version"
  fi
}

prerequisties
setup
main
#cleanup
